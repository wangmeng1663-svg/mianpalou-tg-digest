# 部署示例：登录 VPS 后保存为 /etc/systemd/system/mianpalou.service
# 然后执行：
#   systemctl daemon-reload
#   systemctl enable --now mianpalou
#   systemctl status mianpalou --no-pager
# 注意：WorkingDirectory 里要放 .env（含 BOT_TOKEN / LLM Key），首次需先建好 venv 并 playwright install chromium
[Unit]
Description=MianPalou TG digest bot
After=network-online.target

[Service]
WorkingDirectory=/opt/mianpalou
ExecStart=/opt/mianpalou/venv/bin/python bot.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
# 1G 小机保命：bot（含 Chromium 渲染）内存超限就杀掉重启，避免整机僵死
MemoryHigh=500M
MemoryMax=800M
MemorySwapMax=512M

[Install]
WantedBy=multi-user.target
