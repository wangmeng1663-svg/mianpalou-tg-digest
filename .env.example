# 复制为 .env 后填入真实值：cp .env.example .env

# ===== 必填 =====
# BotFather 给你的 token（创建后务必 /setprivacy -> Disable，否则收不到群消息）
BOT_TOKEN=

# ===== LLM（默认 DeepSeek，兼容 OpenAI 格式的都能用）=====
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 切 Gemini 时把 LLM_PROVIDER 改成 gemini，并填这两个
GEMINI_API_KEY=
LLM_MODEL=gemini-2.0-flash

# ===== 运营 =====
# 你自己的 TG 数字 ID，用于接收运营数据私聊（@userinfobot 可查）。填 0 = 不接收
OWNER_ID=0
# 机器人 username（不带 @），用于日报页脚引流
BOT_USERNAME=MianPalouBot

# ===== 网络 =====
# 本机跑需要梯子时填，如 socks5h://127.0.0.1:10808 或 http://127.0.0.1:7890
# VPS 能直连 Telegram 就留空
PROXY_URL=

# ===== 行为参数 =====
# 展示用时区
TZ=Asia/Shanghai
# 冷场阈值：24h 内少于这么多条就不发
MIN_MESSAGES=10
# 群数上限（防滥用）
MAX_GROUPS=50

# 发送时间固定为「群语言对应时区的当地 20:00」，见 config.py 的 SEND_LOCAL_HOUR
